{
  "name": "rea-project-rank-reel-editor",
  "version": "2.0.0",
  "private": true,
  "description": "Personal web-based Rank Reel Editor for YouTube Shorts (9:16 1080x1920) with local Node.js + FFmpeg rendering, hardware-synced playback, and full font studio",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "test": "node tests/validate-workflow.js && node tests/validate-playback-and-fonts.js",
    "test:workflow": "node tests/validate-workflow.js",
    "test:playback-fonts": "node tests/validate-playback-and-fonts.js",
    "check:ffmpeg": "ffmpeg -version && ffprobe -version"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
